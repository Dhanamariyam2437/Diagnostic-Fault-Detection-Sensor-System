/* ds18b20.c - DS18B20 temperature sensor, 1-Wire on PA0 (bit-banged) */
#include "ds18b20.h"

#define DS_LOW()      (DS18B20_PORT->BSRR = (uint32_t)DS18B20_PIN << 16)
#define DS_RELEASE()  (DS18B20_PORT->BSRR = (uint32_t)DS18B20_PIN)
#define DS_READ()     (((DS18B20_PORT->IDR & DS18B20_PIN) != 0U) ? 1U : 0U)

static uint8_t dwt_ok = 0;

/* ---- microsecond delay using the CPU cycle counter ---- */
static void dwt_init(void)
{
    uint32_t a;
    CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk;
    DWT->CYCCNT = 0;
    DWT->CTRL |= DWT_CTRL_CYCCNTENA_Msk;
    a = DWT->CYCCNT;
    __NOP(); __NOP(); __NOP(); __NOP();
    dwt_ok = (DWT->CYCCNT != a) ? 1U : 0U;
}

__attribute__((optimize("O2")))
static void delay_us(uint32_t us)
{
    if (dwt_ok)
    {
        uint32_t start = DWT->CYCCNT;
        uint32_t cycles = us * (SystemCoreClock / 1000000U);
        while ((DWT->CYCCNT - start) < cycles) { }
    }
    else
    {
        volatile uint32_t n = us * (SystemCoreClock / 5000000U);
        while (n--) { }
    }
}

/* ---- 1-Wire basics ---- */
__attribute__((optimize("O2")))
static uint8_t ow_reset(void)
{
    uint8_t presence;
    uint32_t pm;

    DS_LOW();
    delay_us(480);

    pm = __get_PRIMASK();
    __disable_irq();
    DS_RELEASE();
    delay_us(70);
    presence = (DS_READ() == 0U) ? 1U : 0U;
    __set_PRIMASK(pm);

    delay_us(410);
    return presence;
}

__attribute__((optimize("O2")))
static void ow_write_bit(uint8_t bit)
{
    uint32_t pm = __get_PRIMASK();
    __disable_irq();
    DS_LOW();
    if (bit)
    {
        delay_us(6);
        DS_RELEASE();
        delay_us(64);
    }
    else
    {
        delay_us(60);
        DS_RELEASE();
        delay_us(10);
    }
    __set_PRIMASK(pm);
}

__attribute__((optimize("O2")))
static uint8_t ow_read_bit(void)
{
    uint8_t b;
    uint32_t pm = __get_PRIMASK();
    __disable_irq();
    DS_LOW();
    delay_us(3);
    DS_RELEASE();
    delay_us(9);
    b = (uint8_t)DS_READ();
    delay_us(55);
    __set_PRIMASK(pm);
    return b;
}

__attribute__((optimize("O2")))
static void ow_write_byte(uint8_t v)
{
    uint8_t i;
    for (i = 0; i < 8U; i++)
    {
        ow_write_bit((uint8_t)(v & 1U));
        v >>= 1;
    }
}

__attribute__((optimize("O2")))
static uint8_t ow_read_byte(void)
{
    uint8_t i, v = 0;
    for (i = 0; i < 8U; i++)
    {
        v >>= 1;
        if (ow_read_bit()) { v |= 0x80U; }
    }
    return v;
}

static uint8_t crc8(const uint8_t *d, uint8_t n)
{
    uint8_t crc = 0, i, b, mix;
    while (n--)
    {
        b = *d++;
        for (i = 0; i < 8U; i++)
        {
            mix = (uint8_t)((crc ^ b) & 1U);
            crc >>= 1;
            if (mix) { crc ^= 0x8CU; }
            b >>= 1;
        }
    }
    return crc;
}

/* ---- public functions ---- */
void DS18B20_Init(void)
{
    GPIO_InitTypeDef g = {0};

    __HAL_RCC_GPIOA_CLK_ENABLE();
    HAL_GPIO_WritePin(DS18B20_PORT, DS18B20_PIN, GPIO_PIN_SET);

    g.Pin = DS18B20_PIN;
    g.Mode = GPIO_MODE_OUTPUT_OD;      /* open-drain, the 4.7k resistor pulls it high */
    g.Pull = GPIO_NOPULL;
    g.Speed = GPIO_SPEED_FREQ_HIGH;
    HAL_GPIO_Init(DS18B20_PORT, &g);

    dwt_init();
}

uint8_t DS18B20_StartConversion(void)
{
    if (!ow_reset()) return 0;
    ow_write_byte(0xCC);   /* skip ROM  */
    ow_write_byte(0x44);   /* convert T */
    return 1;
}

uint8_t DS18B20_ReadTemp(int16_t *temp_x10)
{
    uint8_t buf[9];
    uint8_t i;
    int16_t raw;

    if (!ow_reset()) return 0;
    ow_write_byte(0xCC);   /* skip ROM         */
    ow_write_byte(0xBE);   /* read scratchpad  */
    for (i = 0; i < 9U; i++) { buf[i] = ow_read_byte(); }
    if (crc8(buf, 8) != buf[8]) return 0;

    raw = (int16_t)(((uint16_t)buf[1] << 8) | buf[0]);
    *temp_x10 = (int16_t)(((int32_t)raw * 10) / 16);   /* 1/16 degree units -> tenths */
    return 1;
}
