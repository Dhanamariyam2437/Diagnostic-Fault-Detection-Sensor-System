#ifndef I2C_LCD_H
#define I2C_LCD_H

#ifdef __cplusplus
extern "C" {
#endif

#include "stm32f1xx_hal.h"

/* 16x2 LCD with PCF8574 I2C backpack (addr7 = 7-bit address: 0x27 or 0x3F) */
void    LCD_Init(I2C_HandleTypeDef *hi2c, uint8_t addr7);
void    LCD_Clear(void);
void    LCD_SetCursor(uint8_t row, uint8_t col);
void    LCD_Print(const char *s);
void    LCD_PrintLine(uint8_t row, const char *s);  /* writes 16 chars, pads with spaces */
uint8_t LCD_Failed(void);                           /* 1 if an I2C write failed */

#ifdef __cplusplus
}
#endif

#endif /* I2C_LCD_H */
