/* i2c_lcd.c - 16x2 LCD through a PCF8574 I2C backpack (4-bit mode)
 * Backpack pin map: P0=RS, P1=RW, P2=EN, P3=Backlight, P4..P7=D4..D7 */
#include "i2c_lcd.h"

#define PIN_RS  0x01U
#define PIN_RW  0x02U
#define PIN_EN  0x04U
#define PIN_BL  0x08U

static I2C_HandleTypeDef *lcd_i2c;
static uint8_t lcd_addr8 = 0x27U << 1;
static uint8_t lcd_fail = 0;

/* Send bytes to the backpack. After the first error, further sends are skipped
 * (so a missing LCD can't freeze the program); the I2C bus is reset. */
static void lcd_tx(const uint8_t *buf, uint16_t n)
{
    if (lcd_fail) return;
    if (HAL_I2C_Master_Transmit(lcd_i2c, lcd_addr8, (uint8_t *)buf, n, 20) != HAL_OK)
    {
        lcd_fail = 1;
        HAL_I2C_DeInit(lcd_i2c);
        HAL_I2C_Init(lcd_i2c);
    }
}

/* send one nibble (used only during the start-up sequence) */
static void lcd_nibble(uint8_t nib)
{
    uint8_t d = (uint8_t)((nib << 4) & 0xF0U) | PIN_BL;
    uint8_t b[2] = { (uint8_t)(d | PIN_EN), d };
    lcd_tx(b, 2);
}

/* send one full byte: rs=0 command, rs=1 character */
static void lcd_byte(uint8_t v, uint8_t rs)
{
    uint8_t f  = (uint8_t)(PIN_BL | (rs ? PIN_RS : 0U));
    uint8_t hi = (uint8_t)(v & 0xF0U);
    uint8_t lo = (uint8_t)((v << 4) & 0xF0U);
    uint8_t b[4] = {
        (uint8_t)(hi | f | PIN_EN), (uint8_t)(hi | f),
        (uint8_t)(lo | f | PIN_EN), (uint8_t)(lo | f)
    };
    lcd_tx(b, 4);
}

void LCD_Init(I2C_HandleTypeDef *hi2c, uint8_t addr7)
{
    lcd_i2c   = hi2c;
    lcd_addr8 = (uint8_t)(addr7 << 1);
    lcd_fail  = 0;

    HAL_Delay(50);
    lcd_nibble(0x03); HAL_Delay(5);
    lcd_nibble(0x03); HAL_Delay(5);
    lcd_nibble(0x03); HAL_Delay(1);
    lcd_nibble(0x02); HAL_Delay(1);   /* switch to 4-bit mode */

    lcd_byte(0x28, 0);                /* 4-bit, 2 lines, 5x8 font */
    lcd_byte(0x08, 0);                /* display off */
    lcd_byte(0x01, 0); HAL_Delay(3);  /* clear */
    lcd_byte(0x06, 0);                /* entry mode: move right */
    lcd_byte(0x0C, 0);                /* display on, cursor off */
}

void LCD_Clear(void)
{
    lcd_byte(0x01, 0);
    HAL_Delay(2);
}

void LCD_SetCursor(uint8_t row, uint8_t col)
{
    uint8_t addr = (uint8_t)((row == 0U ? 0x00U : 0x40U) + col);
    lcd_byte((uint8_t)(0x80U | addr), 0);
}

void LCD_Print(const char *s)
{
    while (*s && !lcd_fail)
    {
        lcd_byte((uint8_t)*s++, 1);
    }
}

void LCD_PrintLine(uint8_t row, const char *s)
{
    uint8_t i;
    LCD_SetCursor(row, 0);
    for (i = 0; i < 16U; i++)
    {
        char c = ' ';
        if (*s) { c = *s++; }
        lcd_byte((uint8_t)c, 1);
    }
}

uint8_t LCD_Failed(void)
{
    return lcd_fail;
}
